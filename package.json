{
  "name": "mingli-bench",
  "version": "0.1.0",
  "private": true,
  "description": "命理鉴心：紫微斗数六维分与人物匹配的确定性引擎、测试与分布评测",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "simulate": "node scripts/simulate.ts",
    "llm:run": "NODE_USE_ENV_PROXY=1 node scripts/llm/run.ts",
    "llm:analyze": "node scripts/llm/analyze.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --external:iztro --outfile=dist/mingli-engine.cjs",
    "crosscheck": "node scripts/crosscheck.ts",
    "llm:recall": "node scripts/llm/recall.ts",
    "llm:compare": "node scripts/llm/compare.ts deepseek-chat deepseek-chat-prodtext claude-haiku-subagent claude-sonnet-subagent"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangmao-gif/mingli-bench.git"
  },
  "license": "CC-BY-NC-4.0",
  "dependencies": {
    "iztro": "2.5.8"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "lunar-javascript": "^1.6.12"
  },
  "main": "dist/mingli-engine.cjs"
}
